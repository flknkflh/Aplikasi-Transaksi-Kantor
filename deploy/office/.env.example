# cp .env.example .env  and change every secret before exposing this anywhere.
KEYSTORE_KEK=CHANGE_ME_openssl_rand_hex_32
SERVER_NAME=Arsip Pusat
OFFICE_SECRET=CHANGE_ME_openssl_rand_hex_32
PQC_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
TTD_DB_PASSWORD=CHANGE_ME
LEDGER_DB_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Leave empty: the super admin is created with a random password shown once in the ttd log.
PQC_SUPERADMIN_PASSWORD=
# Demo seeding only — REMOVE both lines in a real deployment (create admins from /superadmin):
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Where QR codes point (the address users' browsers use):
PQC_PUBLIC_BASE_URL=http://localhost:18099
# Set true only with a running Fabric network wired into ledger-api:
FABRIC_ENABLED=false

# HTTPS (docs/adr/0009, TLS.md): comma-separated SANs for the self-signed cert
# generated on first boot. Add your LAN IP/hostname here if you'll reach the
# server as something other than localhost, e.g.:
#   TLS_HOSTS=localhost,127.0.0.1,172.16.23.177,arsip.kantor.local
# Set to empty (TLS_HOSTS=) to turn HTTPS off entirely.
TLS_HOSTS=localhost,127.0.0.1
