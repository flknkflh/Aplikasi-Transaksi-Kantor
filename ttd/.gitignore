# ---- private keys and secrets (Rencana V1 §9.3) ----
*.key
*.key.pem
*.pkcs8.pem
*.pk8
*.pk8.enc
*.pqk
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
pki/private/
pki/offline-root/
pki/intermediate/private/

# ca-admin working directories (hold Root/Intermediate private keys)
ca/
lab-ca/
tools/ca-admin/ca/
deploy/lab/ca/

# deploy secrets + mounted public PKI (regenerated per environment)
deploy/lab/.env.lab
deploy/lab/pki/*.pem

# ---- databases, object storage, local runtime ----
runtime/
data/
/dist/
/build/
spike-out/
lab-pki/
*.out

# ---- Android build outputs (AAR is reproduced from source via build-aar.sh) ----
apps/android/app/libs/*.aar
apps/android/app/libs/*-sources.jar
apps/android/app/libs/*.jar
.gradle/
apps/android/**/build/
apps/android/local.properties
apps/android/.kotlin/
*.apk
*.aab

# ---- Wails desktop build outputs ----
apps/windows/cmd/pqcsign-desktop/build/
apps/windows/cmd/pqcsign-desktop/frontend/wailsjs/

# Android spike fixtures are generated by :app:generateSpikeFixtures (contain a
# throwaway lab private key — must never enter git history, §5.3 / §9.3).
apps/android/app/src/main/assets/sample*.pdf
apps/android/app/src/main/assets/lab/*
!apps/android/app/src/main/assets/lab/README.md

# ---- reference repository clones (studied, not vendored) ----
research/pdfsign/
research/pdfsigner/

# ---- toolchain noise ----
*.exe
*.test
*.prof
.DS_Store
