# Copy to .env and fill in. `.env` is git-ignored.
#
#   cp .env.example .env
#   nano .env

# Where QR codes point (they encode <this>/s/<id>): the public address of the
# verification-only site. Local default is this machine; on a server use its
# public address (ideally https).
PQC_PUBLIC_BASE_URL=http://localhost:18098

# Host ports (container ports stay 8099 full API + /app/ + /admin, 8098 verify-only).
#PQC_API_PORT=18099
#PQC_VERIFY_PORT=18098

# Token signing key. Generate a fresh one:  openssl rand -hex 32
PQC_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# PostgreSQL password. Generate:  openssl rand -hex 16
PQC_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_16
