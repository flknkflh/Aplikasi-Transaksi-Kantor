# Copy to .env and fill in. `.env` is git-ignored.
#
#   cp .env.example .env
#   nano .env

# The public address of this server. QR codes encode <this>/v/<id>, and it is
# the default server URL the desktop/Android apps show. On a VPS use the
# public IP (or a domain) and keep the :8099 port.
PQC_PUBLIC_BASE_URL=http://136.244.116.132:8099

# Token signing key. Generate a fresh one:  openssl rand -hex 32
PQC_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# PostgreSQL password. Generate:  openssl rand -hex 16
PQC_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_16
